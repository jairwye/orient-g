{
  "version": 1,
  "skill_id": "skill.finance.annual_report.v1",
  "subject_types": {
    "balance_sheet": {
      "keywords": [
        "货币资金",
        "应收账款",
        "应收款项",
        "存货",
        "固定资产",
        "无形资产",
        "长期股权投资",
        "资产总计",
        "负债总计",
        "流动资产",
        "非流动资产"
      ],
      "task_hint": "bs_compare"
    },
    "income_statement": {
      "keywords": [
        "营业收入",
        "营业成本",
        "净利润",
        "销售费用",
        "管理费用",
        "研发费用",
        "财务费用",
        "营业利润"
      ],
      "task_hint": "pnl_compare"
    },
    "cash_flow": {
      "keywords": ["经营活动产生的现金流量净额", "投资活动", "筹资活动", "现金流量"],
      "task_hint": "cf_compare"
    }
  },
  "subject_disambiguation": [
    { "wrong": "应收股利", "not": "应收账款" },
    {
      "wrong": "其他应收款",
      "not": "应收账款",
      "note": "除非用户明确问其他应收款"
    }
  ],
  "query_plan_templates": {
    "bs_balance": [
      "{entity} 合并资产负债表 {subject} {y1} {y2} 年末",
      "{entity} {subject} 期末余额",
      "{entity} 合并资产负债表 {subject}"
    ],
    "pnl_line": [
      "{entity} 合并利润表 {subject} {y1} {y2}",
      "{entity} 主要会计数据 {subject}"
    ],
    "cf_line": ["{entity} 合并现金流量表 {y1} {y2}", "{entity} {subject} {y1} {y2}"],
    "fee_note": ["{entity} {subject} 附注 明细", "{entity} {subject} 2024 2025"],
    "pnl_narrative": [
      "{entity} {subject} 财务报表项目重大变动说明",
      "{entity} 经营情况讨论 {subject}",
      "{entity} 管理层讨论 {subject} 变动"
    ],
    "hk_extra": [
      "{entity} Consolidated Statement of Financial Position {subject_en}",
      "{entity} consolidated balance sheet {subject_en}"
    ],
    "sec_extra": [
      "{entity} Consolidated Balance Sheets {subject_en}",
      "{entity} Item 8 {subject_en}"
    ]
  },
  "required_evidence": {
    "bs_balance_compare": {
      "slot": "statement_table",
      "rule": "subject_and_two_amounts_same_line_or_near",
      "gap_message": "未命中合并资产负债表（或同等主表）中该科目的两期期末余额"
    },
    "pnl_amount_compare": {
      "slot": "statement_table",
      "rule": "subject_and_two_amounts_same_line_or_near",
      "gap_message": "未命中合并利润表或主要会计数据中该科目的两期金额"
    },
    "cf_amount_compare": {
      "slot": "statement_table",
      "rule": "subject_and_two_amounts_same_line_or_near",
      "gap_message": "未命中合并现金流量表中该活动的两期金额"
    },
    "pnl_narrative_change": {
      "slot": "narrative_change",
      "rule": "subject_change_reason_or_mda",
      "gap_message": "未命中营业收入等科目的变动原因/重大变动说明（仅有金额不够）"
    }
  },
  "scoring_hints": {
    "balance_sheet": {
      "boost_terms": [
        "合并资产负债表",
        "综合财务状况表",
        "Consolidated Balance Sheets",
        "期末",
        "年末"
      ],
      "demote_if_only": ["变动原因", "主要系", "同比减少", "同比增加"]
    },
    "income_statement": {
      "boost_terms": ["合并利润表", "综合损益表", "营业收入", "Consolidated Statements of Operations"]
    },
    "cash_flow": {
      "boost_terms": [
        "合并现金流量表",
        "综合现金流量表",
        "Consolidated Statements of Cash Flows"
      ]
    }
  },
  "supplemental_policy": {
    "prefer_gaps_over_narrative_filter": true,
    "max_extra_queries_per_gap": 2
  }
}
