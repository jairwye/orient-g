{
  "mcp_servers": {
    "orientg": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "-e",
        "ORIENTG_USER_TOKEN",
        "BACKEND_CONTAINER_NAME",
        "python",
        "-m",
        "backend.mcp.orientg_server"
      ],
      "env": {
        "ORIENTG_USER_TOKEN": "仅 CLI 单人调试；生产多用户勿依赖此 env，见 docs/hermes.md §4"
      }
    }
  }
}
