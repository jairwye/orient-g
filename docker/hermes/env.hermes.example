# Hermes Agent 容器环境（复制为项目根目录 .env.hermes，勿提交 Git）
# 官方说明：https://hermes-agent.nousresearch.com/docs/
# Orient-G 操作：docs/hermes.md §3
#
# 与项目根 .env 对齐：
#   HERMES_INTERNAL_TOKEN（.env）= 下方 API_SERVER_KEY
#   HERMES_BASE_URL=http://hermes-agent:8642（写在 .env，不写本文件）
#   DATABASE_URL 仅在 backend 容器 .env / compose 注入；MCP docker exec 进 backend 后读同一连接
#   OPENAI_API_BASE 须与 .env 中 LLM_BASE_URL 指向同一内网推理（容器视角，如 host.docker.internal）
#   多用户 JWT 勿写 ORIENTG_USER_TOKEN（docs/hermes.md §4）

# --- OpenAI 兼容 API（Hermes Gateway；backend 经 HERMES_BASE_URL 调用）---
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=changeme-must-match-root-env-HERMES_INTERNAL_TOKEN

# --- 对话 LLM（须与项目根 .env 的 LLM_BASE_URL 同一网关；容器视角 URL）---
# Linux 宿主机 llama：http://host.docker.internal:28800/v1
# 若 LLM 也在 compose 内网：http://<服务名>:端口/v1
OPENAI_API_BASE=http://host.docker.internal:28800/v1
OPENAI_API_KEY=
# 若 Hermes 使用其它变量名，以你锁定的 Hermes 版本文档为准，并同步到 docs/hermes.md

# --- 终端沙盒（推荐）---
# HERMES_TERMINAL_BACKEND=docker

# --- 二期：内网搜索 / lark CLI（默认关）---
# HERMES_SEARXNG_ENABLED=false
# HERMES_LARK_CLI_ENABLED=false
