# 本机 Hermes Gateway（复制到 Windows：%USERPROFILE%\.hermes\.env）
# 见 docs/hermes.md §2.4
#
# /agent 完整链路：此处只配 Gateway 密钥，勿写死用户 JWT（多用户见 §4）。
# 项目根 .env 需同时启用 HERMES_* 且 DATABASE_URL 指向本机开发库（见 .env.example）。

# Gateway（必需；API_SERVER_KEY 与项目根 .env 的 HERMES_INTERNAL_TOKEN 一致）
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=请改为长随机串

# 对话 LLM：若已在 %USERPROFILE%\.hermes\config.yaml 的 model: 段配置，可省略
# OPENAI_API_BASE=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=

# 仅 hermes chat 单人调 MCP 时临时加（/agent 不需要）：
# ORIENTG_USER_TOKEN=
# 示例见 docker/hermes/dotenv.hermes.orientg.example
