# =============================================================================
# 使用方式：复制本文件为 .env，再按需修改。.env 已被 git 忽略，勿提交。
# - 本地开发：在项目根目录保留 .env，主要改「本地开发」段。
# - Docker 生产：在部署目录（如 ~/docker/orient-g）git clone 本仓库后，复制本文件为 .env。
#   docker compose pull 只拉镜像，不会带上 compose / Caddyfile / docker/hermes/，须保留仓库目录。
#
# 其它示例文件（Hermes 等）：
#   docker/hermes/env.hermes.example              → 项目根 .env.hermes（生产 Hermes 容器）
#   docker/hermes/dotenv.hermes.gateway.example   → %USERPROFILE%\.hermes\.env（本机 Gateway）
#   docker/hermes/dotenv.hermes.orientg.example   → 同上，仅 hermes chat 单人调试 JWT
#   docker/hermes/mcp-orientg.windows.example.yaml → %USERPROFILE%\.hermes\config.yaml
#   frontend/.env.local.example                   → frontend/.env.local
#   操作说明：docs/hermes.md
# =============================================================================

# -----------------------------------------------------------------------------
# 本地开发（跑 backend/frontend 在本机时使用）
# -----------------------------------------------------------------------------
# 本机 PostgreSQL（与生产库隔离；勿把开发 .env 指到生产 DATABASE_URL）
#
# 连接串格式（主机与库名之间只有一个 /，勿写成 //mgmt_web）：
#   postgresql://用户名:密码@主机:端口/数据库名
#
# 常见本机安装（Windows 服务名 postgresql-x64-xx）：
#   - 用户：安装时设的 superuser，多为 postgres
#   - 端口：默认 5432
#   - 库名：mgmt_web（若不存在，用 psql 超级用户执行 CREATE DATABASE mgmt_web;）
#
# Windows：若 localhost 连不上或 psycopg2 报错难读，可改用 127.0.0.1
# 密码含 @ # / : 等字符须 URL 编码（见 docs/汇率-PostgreSQL排查.md）
#
DATABASE_URL=postgresql://postgres:你的密码@127.0.0.1:5432/mgmt_web

# 上传文件目录（本地从项目根启动后端时用；Docker 内固定为 /app/uploads）
UPLOAD_DIR=./uploads

# 竞品财报：无 upload Snapshot 时回退仓库内 YYCQ 蓝本 fixture（本地 dev 默认开；显式 false 或 APP_ENV=production 时关）
# COMPETITOR_FIXTURE_FALLBACK=true

# 纵向 PDF zip：内网中文 PDF 文件名规则（JSON 数组，仅生产 .env / 勿提交 GitHub）
# 或写入 uploads/competitor/vertical_company_rules.json（持久化在 uploads 卷，推荐）
# 格式：[{"id":"37","patterns":["…"]},{"id":"wm","patterns":["…"]}, …]  id 为 canonical slug
# VERTICAL_COMPANY_RULES_JSON=
# 生产未配置上述两项时，默认启用内建 7 家中文 PDF 文件名规则；公开 fork 可设 false
# VERTICAL_BUILTIN_FILENAME_RULES=false

# 可选：前端地址，用于 CORS（本地开发可省略）
# FRONTEND_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# 资源治理 / 前端智能轮询（可选：不设则走前端默认值）
# -----------------------------------------------------------------------------
# 说明：
# - 该类变量仅对前端生效（Next.js 需 NEXT_PUBLIC_ 前缀）；修改后需重启前端 dev server / 重新构建镜像。
# - 建议生产保持“保守轮询”：页面不可见时不轮询；无活跃任务时自动停止；错误触发退避与冷却，避免打爆后端。
#
# 轮询模式：
# - auto：智能轮询（推荐/默认）：仅在“页面可见 + 有活跃任务/文档”时轮询；完成后自动停止
# - always：始终轮询（仅用于排查；生产不推荐）
# - off：禁用轮询（仅显示静态状态，需手动刷新）
# NEXT_PUBLIC_POLL_MODE=auto
#
# 错误退避与冷却（生产建议：冷却 >= 60s）
# - 连续错误次数达到阈值后进入 cooldown（冷却期内不再请求，直到时间到期或用户手动触发刷新）
# NEXT_PUBLIC_POLL_ERROR_MAX_MS=60000
# NEXT_PUBLIC_POLL_ERROR_COOLDOWN_AFTER=3
# NEXT_PUBLIC_POLL_ERROR_COOLDOWN_MS=120000

# 可选：登录 JWT 签名密钥（本地可用默认；生产务必改为强随机值）
# AUTH_SECRET=orient-g-auth-secret-change-in-production

# -----------------------------------------------------------------------------
# Docker / 生产部署（docker compose 会读取同目录 .env，只改下面即可）
# -----------------------------------------------------------------------------
# 数据库：用户名、密码、库名（compose 会据此拼 DATABASE_URL 给 backend）
POSTGRES_USER=mgmt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mgmt_web
# 知识库向量 RAG 需 pgvector；默认 pgvector/pgvector:pg16（纯 Postgres 可设 postgres:16-alpine）
# POSTGRES_IMAGE=pgvector/pgvector:pg16

# 数据库结构迁移模式：
# - legacy：启动时自动建表/补列（默认）
# - alembic：由 Alembic 显式迁移管理（生产推荐；避免应用启动时“隐式改表”）
DB_MIGRATION_MODE=alembic

# 登录 JWT 签名密钥（生产务必改为强随机，如：openssl rand -hex 32）
AUTH_SECRET=orient-g-auth-secret-change-in-production
# 运行环境（development / production）：production 下默认启用默认密钥守卫
APP_ENV=production
# 竞品财报：生产默认关闭 fixture 回退（无上传时 GET /api/competitor/report 返回 404）
COMPETITOR_FIXTURE_FALLBACK=false
# 显式安全守卫：开启后若 AUTH_SECRET 仍为默认值，后端会拒绝启动
ENFORCE_NON_DEFAULT_AUTH_SECRET=true
# 兼容旧 data-parse 会话（无 owner）：允许首次访问时认领并回写 owner；稳定后可改为 false
DATA_PARSE_LEGACY_SESSION_CLAIM_ENABLED=true

# 前端访问地址（用于 CORS、回调等，如 https://your-internal-domain）
FRONTEND_ORIGIN=http://localhost:3000

# Caddy 监听 IP：127.0.0.1 仅本机；0.0.0.0 为所有网卡（需配合防火墙收窄）；或写固定内网 IP（如 192.168.1.10）。
# 若用 DHCP 且把此处写成「某次租到的地址」，重启后 IP 变化可能导致端口发布/访问不一致，表现为需 force-recreate caddy；生产建议固定 IP 或 0.0.0.0+防火墙。
BIND_IP=127.0.0.1

# 域名访问时填：与 BIND_IP 同机的域名及 IP，避免用域名访问时 502（Caddyfile 中反代会把 Host 改成此 IP）
# CADDY_DOMAIN=caiwu.example.com
# CADDY_BACKEND_HOST=192.168.1.10

# 可选：覆盖默认镜像（不改则用 ghcr.io 的 latest）
# BACKEND_IMAGE=ghcr.io/jairwye/orient-g-backend:latest
# FRONTEND_IMAGE=ghcr.io/jairwye/orient-g-frontend:latest

# --- Docker 生产：LLM / Ollama（backend 容器内 URL；按宿主机实际改 LLM_*）---
# LLM_BASE_URL=http://host.docker.internal:28800/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3.6-35b-apex
# AI_UPSTREAM_BLOCK_REMOTE=true
# AI_UPSTREAM_ALLOWED_HOSTS=localhost,127.0.0.1,::1,ollama,docling,hermes-agent,backend,host.docker.internal
# OLLAMA_URL=http://ollama:11434
# OLLAMA_EMBED_MODEL=bge-m3
# KB_VECTOR_ENABLED=true
# KB_EMBEDDING_DIM=1024

# --- Docker 生产：Hermes Agent（须同时 cp docker/hermes/env.hermes.example → .env.hermes）---
# 启动：docker compose -f docker-compose.yml -f docker-compose.hermes.yml up -d
# HERMES_INTERNAL_TOKEN 必须与 .env.hermes 里 API_SERVER_KEY 完全相同（openssl rand -hex 32）
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_PULL_POLICY=if_not_present
HERMES_ENABLED=true
HERMES_DEV_MOCK=false
HERMES_BASE_URL=http://hermes-agent:8642
HERMES_INTERNAL_TOKEN=CHANGE_ME_SAME_AS_DOT_ENV_HERMES_API_SERVER_KEY
HERMES_MODEL=hermes-agent
HERMES_REQUEST_TIMEOUT_S=600
HERMES_AGENT_KB_PREFETCH=true
HERMES_AGENT_KB_SYNTHESIZE=true
HERMES_AGENT_KB_FAST_PATH=false
HERMES_AGENT_ROUTE_DEFAULT=tier0
HERMES_AGENT_KB_MULTI_QUERY=true
HERMES_AGENT_STANDARD_TIER0=true
HERMES_AGENT_KB_ASK_BUDGET_LITE=2
HERMES_AGENT_SIMPLE_QUERY_FAST=true
HERMES_AGENT_STREAM=true
HERMES_AGENT_USE_RUNS_API=false
HERMES_STREAM_REASONING=false
KB_EVIDENCE_CHUNK_MAX_CHARS=15000
AGENT_REQUIRE_RUN_ID=true
# MCP 配置：合并 docker/hermes/mcp-orientg.snippet.json → hermes_state 卷（见 docs/hermes.md §3.5）

# -----------------------------------------------------------------------------
# 新闻政策页（FreshRSS）：全部不设则新闻政策仅返回空，不拉取
# -----------------------------------------------------------------------------
# GReader API 根地址（如 https://rss.example.com/api/greader.php）
# FRESHRSS_API_URL=
# 单账号用户名
# FRESHRSS_USER=
# API 密码（FreshRSS 设置里重置的 API 密码）
# FRESHRSS_API_PASSWORD=
# 三个分类名，逗号分隔，对应页上按钮「观点/新闻/AI」（默认：游戏观点,游戏新闻,AI新闻）
# FRESHRSS_LABELS=游戏观点,游戏新闻,AI新闻
# 每类最多保留条数（默认 80）
# FRESHRSS_MAX_ITEMS=80
# 定时间隔（分钟，默认 10）
# FRESHRSS_FETCH_INTERVAL_MINUTES=10
# 缓存 TTL（秒，默认 600）
# FRESHRSS_CACHE_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# OpenAI 兼容 LLM（对话、数据解析、Agent/Hermes 编排；与 Ollama 嵌入解耦）
# -----------------------------------------------------------------------------
# 本地开发示例：
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5-7b-instruct
#
# Docker 生产（backend 容器内访问；LLM 在宿主机时用 host.docker.internal 或内网 IP）：
# LLM_BASE_URL=http://host.docker.internal:28800/v1
# LLM_API_KEY=
# LLM_MODEL=your-model-id
# AI_UPSTREAM_BLOCK_REMOTE=true
# AI_UPSTREAM_ALLOWED_HOSTS=localhost,127.0.0.1,::1,ollama,docling,hermes-agent,backend,host.docker.internal

# -----------------------------------------------------------------------------
# Hermes Agent（/agent 智能体；操作手册 docs/hermes.md）
# -----------------------------------------------------------------------------
# 配置文件分工：
#   项目根 .env          → 本地开发用下方 A)；Docker 生产用上方「Docker / 生产部署」段内已写好的 Hermes 块
#   项目根 .env.hermes   → 仅 Docker 生产 Hermes 容器（cp docker/hermes/env.hermes.example）
#   ~/.hermes/*          → 仅本机 Hermes CLI（开发）
#
# === A) 本地开发（docs/hermes.md §2）— 生产勿启用本段，改用上方 Docker 段 ===
# HERMES_ENABLED=true
# HERMES_DEV_MOCK=false
# HERMES_BASE_URL=http://127.0.0.1:8642
# HERMES_INTERNAL_TOKEN=与 %USERPROFILE%\.hermes\.env 中 API_SERVER_KEY 相同
# HERMES_MODEL=hermes-agent
# HERMES_REQUEST_TIMEOUT_S=600
# HERMES_AGENT_KB_PREFETCH=true
# HERMES_AGENT_KB_SYNTHESIZE=true
# HERMES_AGENT_KB_FAST_PATH=false
# HERMES_AGENT_ROUTE_DEFAULT=tier0
# HERMES_AGENT_KB_MULTI_QUERY=true
# HERMES_AGENT_STANDARD_TIER0=true
# HERMES_AGENT_KB_ASK_BUDGET_LITE=2
# HERMES_AGENT_SIMPLE_QUERY_FAST=true
# HERMES_AGENT_STREAM=true
# HERMES_AGENT_USE_RUNS_API=false
# HERMES_STREAM_REASONING=false
# KB_EVIDENCE_CHUNK_MAX_CHARS=15000
# AGENT_REQUIRE_RUN_ID=true
#
# === C) 仅单元冒烟（docs/hermes.md §6）===
# HERMES_ENABLED=true
# HERMES_DEV_MOCK=true
# HERMES_SEARXNG_ENABLED=false
# HERMES_LARK_CLI_ENABLED=false

# -----------------------------------------------------------------------------
# Ollama（主要用于知识库 embeddings）：不设则向量嵌入不可用；对话可不依赖 Ollama（见上 LLM_*）
# -----------------------------------------------------------------------------
# 本地开发：http://127.0.0.1:11434 或内网生产机（SSH 隧道见 docs/kb-vector-dev-setup.md）
# Docker 生产（与 compose 同栈）：http://ollama:11434
# OLLAMA_URL=http://ollama:11434
# OLLAMA_EMBED_MODEL=bge-m3
#
# 知识库向量 RAG（需 Postgres 已安装 pgvector；生产迁移后 upgrade head）
# KB_VECTOR_ENABLED=true
# KB_EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# 2.e 队列 / 限流 / 降级（可选：不设则用后端默认值）
# -----------------------------------------------------------------------------
# 双队列容量上限（high/low）
# QUEUE_MAX_SIZE_HIGH=20
# QUEUE_MAX_SIZE_LOW=50
# 高优先级堆积降级阈值（在线路径检测 high 队列 >= 阈值则快速失败）
# QUEUE_DEGRADE_HIGH_THRESHOLD=10
# 持久化队列租约（秒）：worker 会按心跳续租，避免长任务被误回收
# bigpdf 任务由异步队列调度，租约只需覆盖普通文档解析时长即可
QUEUE_WORKER_LEASE_SECONDS=3600
QUEUE_WORKER_HEARTBEAT_SECONDS=60
# running 超时回收（秒）：超过该阈值且无心跳会回收重试/失败
QUEUE_RUNNING_TIMEOUT_SECONDS=7200
# queued 超时清理（秒）：排队过久仍未执行会标记 failed（防“假排队”）
# QUEUE_QUEUED_TIMEOUT_SECONDS=7200
# 单任务最大重试次数与退避（秒）
# QUEUE_TASK_MAX_ATTEMPTS=3
# QUEUE_RETRY_BACKOFF_SECONDS=30
# 退避上限（秒）：避免指数退避增长过快造成“几乎不再重试”
# QUEUE_RETRY_BACKOFF_MAX_SECONDS=900
#
# worker 空转退避（秒）：当没有可执行任务时，用指数退避降低空轮询开销（生产建议开启）
# QUEUE_WORKER_IDLE_MIN_S=0.2
# QUEUE_WORKER_IDLE_MAX_S=5.0
# QUEUE_WORKER_IDLE_BACKOFF=true
#
# 推理/嵌入并发（本机资源信号量）
# GPU_MAX_CONCURRENCY=1
# GPU_ACQUIRE_TIMEOUT_S=10
#
# 在线互动按用户限速（token bucket）
# ONLINE_USER_RPS=0.5
# ONLINE_USER_BURST=3
#
# Ollama 熔断
# OLLAMA_CIRCUIT_FAIL_THRESHOLD=3
# OLLAMA_CIRCUIT_OPEN_SECONDS=30

# =============================================================================
# Docling（知识库文档解析）：生产走独立 sidecar（http）；本地开发可改为 local 直调 CLI
#
# 镜像切换方式：
#   本地侧车：DOCLING_IMAGE=orientg-docling-sidecar:temp（需先 docker build）
#   官方镜像：DOCLING_IMAGE=quay.io/docling-project/docling-serve:latest（默认已配置）
#     - 官方镜像端口：容器内 5001，compose 通过 "8080:5001" 映射与 backend 的 :8080 对齐
#     - 官方镜像内置模型，运行时无需 huggingface 代理和缓存卷
#     - 首次 pull 时需注意 docker 守护进程代理（见 README 生产部署说明）
#     - 官方镜像默认使用 CPU-only PyTorch（无 GPU 时自动 fallback，无需特殊配置）
DOCLING_IMAGE=quay.io/docling-project/docling-serve:latest
DOCLING_PULL_POLICY=if_not_present
DOCLING_MODE=http
# Docling 容器出站代理（可选；仅 docling 服务生效，backend 不走此代理）
# 示例：HTTP_PROXY=http://mihomo:7890  HTTPS_PROXY=http://mihomo:7890
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1,docling,backend,db,frontend,caddy,ollama
# =============================================================================
# Docling HTTP Base URL
# =============================================================================
# docling-serve 官方 API：POST /v1/convert/file/async → 轮询 → GET /v1/result/{task_id}
# 无任何 HTTP 读写超时限制，依赖 queue lease 心跳 + is_cancelled 控制任务生命周期
DOCLING_HTTP_BASE_URL=http://docling:5001/v1
#
# Docling CPU 线程控制（仅官方镜像生效）：
# - DOCLING_NUM_THREADS：PyTorch CPU 线程数，默认 4。减少可避免与其他进程 CPU 争抢
# - DOCLING_PERF_PAGE_BATCH_SIZE：页面批处理大小，默认 4。减少可降低内存峰值（大 PDF 建议设为 2）
DOCLING_NUM_THREADS=4
DOCLING_PERF_PAGE_BATCH_SIZE=2
#
# bigpdf 任务优先级说明：
#   bigpdf（大 PDF 解析）使用 HIGH 优先级 (0)，优先于 user_doc_parse (LOW=1)
#   优先级在 task_queue.py 的 enqueue_bigpdf_task() 中硬编码，无需在 env 配置
#
# 开发保护阀（默认开启）：阻断误连远程生产 AI 服务（Ollama/Docling）
# 如确需直连远程（例如临时联调），可设为 false 或把目标主机加入白名单
# AI_UPSTREAM_BLOCK_REMOTE=true
# AI_UPSTREAM_ALLOWED_HOSTS=localhost,127.0.0.1,::1,ollama,docling,host.docker.internal
#
# 以下仅影响「本地侧车」镜像构建期（可选）：网络不稳时启用国内镜像
# 官方镜像无需构建，不受这些变量影响
# DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_EXTRA_INDEX_URL=
# SKIP_MODEL_DOWNLOAD=1（默认，跳过构建期模型下载；本地侧车运行时会从 huggingface 下载）

# 离线模型目录（运行时）：仅本地侧车需要；官方镜像自带模型，无需此配置
# DOCLING_ARTIFACTS_PATH=/models/docling-artifacts

# -----------------------------------------------------------------------------
# 生产稳定性：资源上限（建议启用，避免任务突发把整机拖垮）
# ------------------------------------------------------------------------------
# Docling（CPU 解析侧车）：
# - 官方镜像默认使用 CPU-only PyTorch（无 GPU 时自动 fallback，无需特殊处理）
# - DOCLING_NUM_THREADS：PyTorch CPU 线程数，影响并发度与 CPU 争抢
# - DOCLING_PERF_PAGE_BATCH_SIZE：页面批处理大小，减少可降低内存峰值
# - 资源配额建议：生产 4CPU 8GB 内存下，CPUs=4.0, Mem=6g~8g
DOCLING_CPUS=4.0
DOCLING_MEM_LIMIT=8g
#
# Ollama（CPU 嵌入侧车）：按模型大小与并发调整
# OLLAMA_CPUS=6.0
# OLLAMA_MEM_LIMIT=12g
