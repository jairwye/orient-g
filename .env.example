# =============================================================================
# 使用方式：复制本文件为 .env，再按需修改。.env 已被 git 忽略，勿提交。
# - 本地开发：在项目根目录保留 .env，主要改「本地开发」段。
# - Docker 生产：把 .env 放在与 docker-compose.yml 同目录，主要改「Docker/生产」段。
# =============================================================================

# -----------------------------------------------------------------------------
# 本地开发（跑 backend/frontend 在本机时使用）
# -----------------------------------------------------------------------------
# 数据库连接串（生产用 Docker 时由 compose 用 POSTGRES_* 拼出，此处仅本地）
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mgmt_web

# 上传文件目录（本地从项目根启动后端时用；Docker 内固定为 /app/uploads）
UPLOAD_DIR=./uploads

# 可选：前端地址，用于 CORS（本地开发可省略）
# FRONTEND_ORIGIN=http://localhost:3000

# 可选：登录 JWT 签名密钥（本地可用默认；生产务必改为强随机值）
# AUTH_SECRET=orient-g-auth-secret-change-in-production

# -----------------------------------------------------------------------------
# Docker / 生产部署（docker compose 会读取同目录 .env，只改下面即可）
# -----------------------------------------------------------------------------
# 数据库：用户名、密码、库名（compose 会据此拼 DATABASE_URL 给 backend）
POSTGRES_USER=mgmt
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mgmt_web

# 登录 JWT 签名密钥（生产务必改为强随机，如：openssl rand -hex 32）
AUTH_SECRET=orient-g-auth-secret-change-in-production

# 前端访问地址（用于 CORS、回调等，如 https://your-internal-domain）
FRONTEND_ORIGIN=http://localhost:3000

# Caddy 监听 IP：127.0.0.1 仅本机，0.0.0.0 所有网卡，或内网 IP 如 192.168.1.10
BIND_IP=127.0.0.1

# 域名访问时填：与 BIND_IP 同机的域名及 IP，避免用域名访问时 502（Caddyfile 中反代会把 Host 改成此 IP）
# CADDY_DOMAIN=caiwu.example.com
# CADDY_BACKEND_HOST=192.168.1.10

# 可选：覆盖默认镜像（不改则用 ghcr.io 的 latest）
# BACKEND_IMAGE=ghcr.io/jairwye/orient-g-backend:latest
# FRONTEND_IMAGE=ghcr.io/jairwye/orient-g-frontend:latest

# -----------------------------------------------------------------------------
# 新闻政策页（FreshRSS）：全部不设则新闻政策仅返回空，不拉取
# -----------------------------------------------------------------------------
# GReader API 根地址（如 https://rss.example.com/api/greader.php）
# FRESHRSS_API_URL=
# 单账号用户名
# FRESHRSS_USER=
# API 密码（FreshRSS 设置里重置的 API 密码）
# FRESHRSS_API_PASSWORD=
# 三个分类名，逗号分隔，对应页上按钮「观点/新闻/AI」（默认：游戏观点,游戏新闻,AI新闻）
# FRESHRSS_LABELS=游戏观点,游戏新闻,AI新闻
# 每类最多保留条数（默认 80）
# FRESHRSS_MAX_ITEMS=80
# 定时间隔（分钟，默认 10）
# FRESHRSS_FETCH_INTERVAL_MINUTES=10
# 缓存 TTL（秒，默认 600）
# FRESHRSS_CACHE_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# Ollama（流程文档等 AI 功能）：不设则相关功能不可用，其余功能正常
# -----------------------------------------------------------------------------
# 生产同栈时：Ollama 独占 GPU（见 docker-compose.yml）；Docling 走 CPU sidecar，勿为 docling 分配 GPU。
# 生产 Docker 与 ollama 同栈时填：http://ollama:11434
# 开发机无 GPU 时，可填局域网内已部署 Ollama 的机器（如生产机）：http://192.168.x.x:11434
# OLLAMA_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# 2.e 队列 / 限流 / 降级（可选：不设则用后端默认值）
# -----------------------------------------------------------------------------
# 双队列容量上限（high/low）
# QUEUE_MAX_SIZE_HIGH=20
# QUEUE_MAX_SIZE_LOW=50
# 高优先级堆积降级阈值（在线路径检测 high 队列 >= 阈值则快速失败）
# QUEUE_DEGRADE_HIGH_THRESHOLD=10
#
# 推理/嵌入并发（本机资源信号量）
# GPU_MAX_CONCURRENCY=1
# GPU_ACQUIRE_TIMEOUT_S=10
#
# 在线互动按用户限速（token bucket）
# ONLINE_USER_RPS=0.5
# ONLINE_USER_BURST=3
#
# Ollama 熔断
# OLLAMA_CIRCUIT_FAIL_THRESHOLD=3
# OLLAMA_CIRCUIT_OPEN_SECONDS=30

# -----------------------------------------------------------------------------
# Docling（知识库文档解析）：本地开发默认 local；Docker compose 默认走独立 sidecar（http）
# -----------------------------------------------------------------------------
# compose 中 docling 镜像名（默认 orientg-docling-sidecar:local）；与 README 手工 build 的 :temp 一致时可改为：
# DOCLING_IMAGE=orientg-docling-sidecar:temp
# DOCLING_MODE=local
# DOCLING_HTTP_BASE_URL=http://docling:8080
# DOCLING_HTTP_TIMEOUT_S=600
#
# 以下仅影响「compose build docling」镜像构建期（可选）：网络不稳时启用国内镜像
# DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_EXTRA_INDEX_URL=
# 默认 1：跳过构建期 docling-tools models download（需 Hugging Face，内网易失败）；设为 0 则预下载模型进镜像（更大）
# SKIP_MODEL_DOWNLOAD=1
#
# 离线模型目录（运行时）：当 docling 侧车无法访问 huggingface.co 时，需要把 docling-tools 下载的 artifacts 解压到该目录并挂载
# DOCLING_ARTIFACTS_PATH=/models/docling-artifacts
#
# docling 单文件解析超时（秒）：大 PDF/扫描件可适当调大
# DOCLING_CLI_TIMEOUT_S=600
